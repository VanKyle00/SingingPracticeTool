* text=auto eol=lf

# Force CRLF on Windows-specific files
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.sln   text eol=crlf
*.vcxproj text eol=crlf

# Source — LF everywhere
*.cpp   text eol=lf
*.h     text eol=lf
*.hpp   text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.cmake text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
CMakeLists.txt text eol=lf

# Binary (avoid diff churn)
*.wav   binary
*.mp3   binary
*.flac  binary
*.mid   binary
*.png   binary
*.jpg   binary
*.ico   binary
*.icns  binary
*.pdf   binary
*.zip   binary
*.tar.gz binary
